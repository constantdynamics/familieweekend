# Kopieer naar .env.local voor lokaal werken. Nooit echte waarden in de repo.

# Server ↔ database, als de gebruiker valk_app.
# Productie: de Supabase-pooler in transactiemodus (poort 6543), bijvoorbeeld
# postgres://valk_app.<project-ref>:<wachtwoord>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://valk_app:wachtwoord@localhost:5432/valk_dev
# "require" voor Supabase, "disable" voor een lokale database.
DATABASE_SSL=disable

# Hoofdgeheim (minstens 32 tekens). Sessies en pepers worden ervan afgeleid.
# Maak er een met: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
APP_SECRET=

# Geheim voor de dagelijkse keepalive (Vercel Cron stuurt het mee).
CRON_SECRET=

# Alleen lokaal: migraties en testgegevens.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/valk_dev
VALK_APP_PASSWORD=wachtwoord
SEED_FAMILY_CODE=VALKTEST
SEED_ADMIN_PIN=482913
SEED_ADMIN_NAME=Beheerder
