{
  "name": "valkenburger-spelen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/prepare.ts && playwright test --trace off",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed-local.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "design:png": "tsx scripts/render-design.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "maak-hash": "tsx --conditions=react-server scripts/maak-hash.ts",
    "scram": "tsx scripts/scram.ts"
  },
  "dependencies": {
    "@serwist/window": "^9.5.15",
    "jose": "^6.2.18",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "1.63.0",
    "@serwist/build": "^9.5.15",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.63.0",
    "serwist": "^9.5.15",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "22.x"
  }
}
